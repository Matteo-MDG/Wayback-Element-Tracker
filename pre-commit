#!/usr/bin/env python3
"""
Pre-commit hook - stamps COMMIT_DATE in wayback_element_tracker.pyw
with the current UTC time, then re-stages the file.

One-time setup (run once after cloning):
    git config core.hooksPath .githooks
    chmod +x .githooks/pre-commit   # Mac / Linux only
"""

import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

TARGET = "wayback_element_tracker.pyw"

# Resolve path relative to the repo root (where git runs the hook from)
path = Path(TARGET)
if not path.exists():
    print(f"[pre-commit] {TARGET} not found - skipping COMMIT_DATE stamp")
    sys.exit(0)

timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

content = path.read_text(encoding="utf-8")
new_content, n = re.subn(
    r'(COMMIT_DATE\s*=\s*")[^"]*(")',
    rf'\g<1>{timestamp}\2',
    content,
)

if n == 0:
    print(f"[pre-commit] COMMIT_DATE not found in {TARGET} - skipping")
    sys.exit(0)

if new_content != content:
    path.write_text(new_content, encoding="utf-8")
    subprocess.run(["git", "add", TARGET], check=True)
    print(f"[pre-commit] COMMIT_DATE set to {timestamp}")
